# ==============================================================================
# CONFIGURAÇÕES DE E-MAIL (SMTP)
# ==============================================================================

# OPÇÃO 1: Mailtrap (Recomendado para Testes/Dev)
# ------------------------------------------------------------------------------
# Crie uma conta em https://mailtrap.io
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=seu_usuario_do_mailtrap
EMAIL_PASSWORD=sua_senha_do_mailtrap
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# OPÇÃO 2: Gmail (Para produção/Envio real)
# ------------------------------------------------------------------------------
# 1. Ative a "Verificação em duas etapas" na sua conta Google.
# 2. Vá em "Segurança" > "Senhas de App".
# 3. Crie uma senha para "E-mail" e "Outro (PrintII)".
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=seu_email@gmail.com
# EMAIL_PASSWORD=sua_senha_de_app_de_16_digitos
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false

# OPÇÃO 3: Outlook / Hotmail
# ------------------------------------------------------------------------------
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USER=seu_email@outlook.com
# EMAIL_PASSWORD=sua_senha
# EMAIL_USE_TLS=true

# OPÇÃO 4: Brevo (Antigo Sendinblue - Recomendado para produção gratuita)
# ------------------------------------------------------------------------------
# 1. Crie uma conta em https://www.brevo.com
# 2. Vá em "SMTP & API" no menu do seu perfil.
# 3. Gere uma nova chave SMTP.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=seu_email_de_cadastro_no_brevo
# EMAIL_PASSWORD=sua_chave_smtp_gerada
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false

# CONFIGURAÇÕES GERAIS
# ------------------------------------------------------------------------------
DEFAULT_FROM_EMAIL='PrintII <noreply@printii.com>'
FRONTEND_URL=http://localhost:5173
